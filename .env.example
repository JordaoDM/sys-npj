# Copie para .env e substitua todos os valores CHANGE_ME.
DB_ROOT_PASSWORD=CHANGE_ME_ROOT_DATABASE_PASSWORD
DB_NAME=npjdatabase
DB_USER=appuser
DB_PASSWORD=CHANGE_ME_APPLICATION_DATABASE_PASSWORD
DB_HOST_PORT=13306

# Use valores aleatórios independentes com, no mínimo, 32 caracteres.
JWT_SECRET=CHANGE_ME_WITH_AT_LEAST_32_RANDOM_CHARACTERS
JWT_REFRESH_SECRET=CHANGE_ME_WITH_ANOTHER_32_RANDOM_CHARACTERS

# Mailpit é usado localmente. Em produção, substitua pelo provedor real.
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=noreply@npj.local

# Usados apenas pelo comando de criação do administrador inicial.
ADMIN_EMAIL=admin@example.invalid
ADMIN_PASSWORD=CHANGE_ME_WITH_A_STRONG_PASSWORD

# Usuários de demonstração criados automaticamente na inicialização.
SEED_TEST_USERS=true
TEST_PROFESSOR_1_EMAIL=professor1@npj.local
TEST_PROFESSOR_1_PASSWORD=TesteNPJ@2026
TEST_PROFESSOR_2_EMAIL=professor2@npj.local
TEST_PROFESSOR_2_PASSWORD=TesteNPJ@2026
TEST_ALUNO_1_EMAIL=aluno1@npj.local
TEST_ALUNO_1_PASSWORD=TesteNPJ@2026
TEST_ALUNO_2_EMAIL=aluno2@npj.local
TEST_ALUNO_2_PASSWORD=TesteNPJ@2026

# Separe múltiplas origens permitidas por vírgula.
FRONTEND_URL=http://localhost:5173

# Níveis aceitos: debug, info, warn e error. Em produção, use info ou warn.
LOG_LEVEL=info

{
  "name": "sistema-npj",
  "version": "1.0.0",
  "description": "Sistema de Gestão do Núcleo de Prática Jurídica",
  "main": "backend/index.js",
  "scripts": {
    "setup": "npm run setup --prefix backend",
    "start": "npm run dev",
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "npm run dev --prefix backend",
    "dev:frontend": "npm run dev --prefix frontend",
    "build": "npm run build:frontend",
    "build:frontend": "npm run build --prefix frontend",
    "test": "npm run test:backend",
    "test:backend": "npm test --prefix backend",
    "test:unit": "npm run test:unit --prefix backend",
    "test:api": "npm run test:api --prefix backend",
    "test:e2e": "npm run test:e2e --prefix frontend",
    "test:e2e:open": "npm run test:e2e:open --prefix frontend",
    "test:agendamentos": "npm run test:agendamentos --prefix backend",
    "migrate": "npm run migrate --prefix backend",
    "migrate:check": "npm run migrate:check --prefix backend",
    "admin:create": "npm run admin:create --prefix backend",
    "install:all": "npm install && npm install --prefix backend && npm install --prefix frontend",
    "test:frontend": "npm run test:e2e --prefix frontend"
  },
  "keywords": [
    "npj",
    "juridico",
    "gestao",
    "processos",
    "nodejs",
    "react",
    "mysql"
  ],
  "author": "Sistema NPJ",
  "license": "MIT",
  "engines": {
    "node": ">=24.19.0 <25",
    "npm": ">=11"
  },
  "dependencies": {
    "@mantine/notifications": "^8.1.3",
    "bcrypt": "^6.0.0",
    "bcryptjs": "^3.0.2",
    "colors": "^1.4.0",
    "cors": "^2.8.5",
    "dotenv": "^17.2.1",
    "express": "^5.1.0",
    "form-data": "^4.0.4",
    "jsonwebtoken": "^9.0.2",
    "mysql2": "^3.14.3",
    "node-cron": "^4.2.1",
    "node-fetch": "^3.3.2",
    "nodemailer": "^7.0.5",
    "sequelize": "^6.37.7"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.2.1",
    "concurrently": "^8.2.2",
    "cypress": "^13.7.0",
    "jest": "^29.7.0",
    "sequelize-cli": "^6.6.3",
    "supertest": "^7.1.4",
    "vite": "^7.0.2"
  }
}
